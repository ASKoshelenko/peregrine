# Copy to .env and fill locally. Never commit real account identifiers or credentials.
PEREGRINE_GCP_PROJECT_ID=peregrine-edge-mlops
PEREGRINE_GCP_ACCOUNT=
PEREGRINE_GCP_BILLING_ACCOUNT_ID=
PEREGRINE_GCP_REGION=us-central1
PEREGRINE_GCP_BUDGET_USD=50
PEREGRINE_GENERAL_CREDIT_REMAINING_USD=
PEREGRINE_GENERAL_CREDIT_EXPIRES=
PEREGRINE_GENAI_CREDIT_REMAINING_USD=
PEREGRINE_GENAI_CREDIT_EXPIRES=
PEREGRINE_GITHUB_REPOSITORY=ASKoshelenko/peregrine
ROBOFLOW_PRIVATE_API_KEY=
ROBOFLOW_PUBLISHABLE_API_KEY=
ROBOFLOW_WORKSPACE_ID=
WANDB_API_KEY=
WANDB_ENTITY=

# Authenticate through the native credential stores instead of putting tokens here:
#   gh auth login
#   gcloud auth login
# CI uses GitHub OIDC -> GCP Workload Identity Federation, not static keys.
